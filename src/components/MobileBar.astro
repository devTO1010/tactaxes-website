---
import { site, type Locale } from '../data/site';
import { useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/* This audience is overwhelmingly mobile — calling must never be more than one tap away. */}
<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-ink/15 bg-white p-3 shadow-[0_-6px_24px_-8px_rgba(0,0,0,0.18)] lg:hidden"
>
  <a
    href={site.phoneHref}
    class="flex items-center justify-center gap-2 rounded-full bg-ink py-3.5 font-display text-[15px] font-semibold text-white"
  >
    <Icon name="phone" size={17} solid />
    {t('mobile.call')}
  </a>
  <a
    href={site.whatsapp}
    rel="noopener"
    class="flex items-center justify-center gap-2 rounded-full bg-[#25D366] py-3.5 font-display text-[15px] font-semibold text-white"
  >
    <Icon name="whatsapp" size={18} solid />
    WhatsApp
  </a>
</div>
