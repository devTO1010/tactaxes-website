---
import { site, type Locale } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { featuredFamilies, otherFamilies, totalServices } from '../data/services';
import { href } from '../lib/url';
import Icon from './Icon.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const es = lang === 'es';

// Build-time reminder: unconfirmed facts must not reach production silently.
const unconfirmed = [
  site.yearsInBusiness === null && 'yearsInBusiness',
  site.hours.some((h) => h.unconfirmed) && 'hours (times are assumed)',
  !site.social.facebook && 'social profile URLs',
  site.credentials === null && 'credentials (EA/CPA/notary/licences)',
].filter(Boolean);
if (unconfirmed.length) {
  console.warn(`\n  [tactaxes] Unconfirmed client data still in site.ts:\n   - ${unconfirmed.join('\n   - ')}\n`);
}

const familyIcons: Record<string, 'docCheck' | 'shield' | 'building' | 'chart' | 'fileText' | 'clock'> = {
  'tax-preparation': 'docCheck',
  'tax-debt-relief': 'shield',
  'company-formation': 'building',
  accounting: 'chart',
  'legal-paperwork': 'fileText',
  'irs-account-help': 'clock',
};

// Only render stats we can actually substantiate.
const stats = [
  { value: `${totalServices}+`, label: t('hero.stat1') },
  site.yearsInBusiness !== null ? { value: String(site.yearsInBusiness), label: t('hero.stat2') } : null,
  { value: String(site.team.length), label: t('hero.stat3') },
].filter((s): s is { value: string; label: string } => s !== null);

const individualPoints = es
  ? ['Preparación de impuestos personales', 'Solicitud y renovación de ITIN', 'Cartas y deudas con el IRS', 'Notarizaciones y apostillados']
  : ['Personal tax preparation', 'ITIN application and renewal', 'IRS letters and tax debt', 'Notarizations and apostilles'];

const businessPoints = es
  ? ['Creación de compañías (LLC) y EIN', 'Contabilidad y nómina', 'Impuestos trimestrales y de ventas', 'Licencias, permisos y contratos']
  : ['Company formation (LLC) and EIN', 'Bookkeeping and payroll', 'Quarterly and sales tax returns', 'Licenses, permits and contracts'];

const trustPoints = [
  { title: t('trust.p1.title'), body: t('trust.p1.body') },
  { title: t('trust.p2.title'), body: t('trust.p2.body') },
  { title: t('trust.p3.title'), body: t('trust.p3.body') },
  { title: t('trust.p4.title'), body: t('trust.p4.body') },
];

const { street, unit, city, region, postalCode } = site.address;
---

<main id="main">
  <!-- ══════════ HERO ══════════ -->
  <section class="bg-white">
    <div class="container-page grid items-center gap-12 pt-14 pb-16 lg:grid-cols-[1.05fr_1fr] lg:gap-16 lg:pt-20 lg:pb-24">
      <div>
        <p class="mb-7 inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-full bg-brand-light py-1.5 pr-4 pl-3 text-[13px] font-semibold text-brand-deep">
          <span class="h-2 w-2 rounded-full bg-brand"></span>
          <span>{t('hero.badge1')}</span>
          <span class="opacity-40">·</span>
          <span>{t('hero.badge2')}</span>
        </p>

        <h1 class="font-display text-[clamp(2.6rem,6.5vw,4.4rem)] leading-[1.02] font-extrabold tracking-[-0.03em] text-ink">
          {t('hero.title1')}<br /><span class="text-brand">{t('hero.title2')}</span>
        </h1>

        <p class="mt-6 max-w-[54ch] text-[17px] leading-relaxed text-ink-soft lg:text-[19px]">{t('hero.body')}</p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.phoneHref}
            class="inline-flex items-center justify-center gap-2.5 rounded-full bg-ink px-7 py-4 font-display text-[17px] font-semibold text-white transition hover:bg-black"
          >
            <Icon name="phone" size={19} solid />
            {t('hero.callCta')}
          </a>
          <a
            href={site.whatsapp}
            rel="noopener"
            class="inline-flex items-center justify-center gap-2.5 rounded-full border-2 border-ink/15 bg-white px-7 py-4 font-display text-[17px] font-semibold transition hover:border-brand hover:text-brand-deep"
          >
            <span class="text-[#25D366]"><Icon name="whatsapp" size={20} solid /></span>
            {t('hero.whatsappCta')}
          </a>
        </div>

        <dl class="mt-10 grid max-w-[520px] gap-4 border-t border-ink/10 pt-8" style={`grid-template-columns:repeat(${stats.length},minmax(0,1fr))`}>
          {
            stats.map((s) => (
              <div>
                <dt class="sr-only">{s.label}</dt>
                <dd>
                  <span class="block font-display text-[28px] leading-none font-extrabold text-ink">{s.value}</span>
                  <span class="mt-1.5 block text-[13px] text-ink-mute">{s.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="relative">
        <div class="overflow-hidden rounded-2xl shadow-[0_24px_70px_-20px_rgba(33,31,32,0.35)]">
          <img
            src={href('/images/storefront.jpg')}
            alt={t('hero.imageAlt')}
            width="983"
            height="716"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </div>
        <p class="absolute -bottom-5 -left-4 flex items-center gap-3 rounded-xl border border-ink/10 bg-white px-5 py-4 shadow-lg sm:left-6">
          <span class="text-brand"><Icon name="pin" size={22} /></span>
          <span class="leading-tight">
            <span class="block font-display text-[15px] font-semibold">{street}, {unit}</span>
            <span class="block text-[13px] text-ink-mute">{city}, {region} {postalCode}</span>
          </span>
        </p>
      </div>
    </div>
  </section>

  <!-- ══════════ TWO DOORS ══════════ -->
  <section id="personas" class="bg-paper py-20 lg:py-24">
    <div class="container-page">
      <div class="mb-12 max-w-[60ch]">
        <p class="mb-3 font-display text-[14px] font-bold tracking-[0.14em] text-brand-dark uppercase">{t('doors.eyebrow')}</p>
        <h2 class="font-display text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-extrabold tracking-[-0.02em]">{t('doors.title')}</h2>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <a
          href="#servicios"
          class="group rounded-2xl border border-ink/10 bg-white p-8 transition-all hover:border-brand hover:shadow-[0_18px_50px_-24px_rgba(33,31,32,0.4)] lg:p-10"
        >
          <span class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-brand-light text-brand-deep">
            <Icon name="user" size={24} />
          </span>
          <h3 class="mb-3 font-display text-[26px] font-bold tracking-[-0.01em]">{t('doors.individuals.title')}</h3>
          <p class="mb-6 leading-relaxed text-ink-soft">{t('doors.individuals.body')}</p>
          <ul class="mb-7 space-y-2.5 text-[15px] text-ink-soft">
            {individualPoints.map((p) => <li class="flex gap-2.5"><span class="font-bold text-brand">✓</span><span>{p}</span></li>)}
          </ul>
          <span class="inline-flex items-center gap-1.5 font-display font-semibold text-brand-dark transition-all group-hover:gap-3">
            {t('doors.individuals.cta')} <span aria-hidden="true">→</span>
          </span>
        </a>

        <a
          id="negocios"
          href="#servicios"
          class="group rounded-2xl bg-ink p-8 text-white transition-all hover:shadow-[0_18px_50px_-20px_rgba(33,31,32,0.6)] lg:p-10"
        >
          <span class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-brand">
            <Icon name="building" size={24} />
          </span>
          <h3 class="mb-3 font-display text-[26px] font-bold tracking-[-0.01em]">{t('doors.businesses.title')}</h3>
          <p class="mb-6 leading-relaxed text-white/70">{t('doors.businesses.body')}</p>
          <ul class="mb-7 space-y-2.5 text-[15px] text-white/75">
            {businessPoints.map((p) => <li class="flex gap-2.5"><span class="font-bold text-brand">✓</span><span>{p}</span></li>)}
          </ul>
          <span class="inline-flex items-center gap-1.5 font-display font-semibold text-brand transition-all group-hover:gap-3">
            {t('doors.businesses.cta')} <span aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════ SERVICES ══════════ -->
  <section id="servicios" class="border-y border-ink/10 bg-white py-20 lg:py-24">
    <div class="container-page">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-[52ch]">
          <p class="mb-3 font-display text-[14px] font-bold tracking-[0.14em] text-brand-dark uppercase">{t('services.eyebrow')}</p>
          <h2 class="font-display text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-extrabold tracking-[-0.02em]">{t('services.title')}</h2>
        </div>
        <p class="max-w-[38ch] text-[15px] text-ink-soft">{t('services.lede')}</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          featuredFamilies.map((f) => (
            <article class="rounded-xl border border-ink/10 bg-paper p-7 transition hover:border-brand">
              <div class="mb-4 flex items-start justify-between">
                <span class="text-brand"><Icon name={familyIcons[f.slug] ?? 'docCheck'} size={26} /></span>
                <span class="rounded-full bg-ink/5 px-2.5 py-1 text-[12px] font-semibold text-ink-mute">
                  {f.services.length}
                  <span class="sr-only"> {t('services.count')}</span>
                </span>
              </div>
              <h3 class="mb-2 font-display text-[19px] font-bold">{es ? f.es : f.en}</h3>
              <p class="text-[14.5px] leading-relaxed text-ink-soft">{es ? f.blurbEs : f.blurbEn}</p>
            </article>
          ))
        }
      </div>

      <div class="mt-5 rounded-xl border border-brand/25 bg-brand-light p-7 lg:p-8">
        <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-5">
          <div class="max-w-[40ch]">
            <h3 class="mb-1.5 font-display text-[19px] font-bold text-brand-deep">{t('services.moreTitle')}</h3>
            <p class="text-[14.5px] text-brand-deep/75">{t('services.moreBody')}</p>
          </div>
          <ul class="flex flex-wrap gap-2">
            {
              otherFamilies.map((f) => (
                <li class="rounded-full bg-white px-4 py-2 text-[14px] font-medium text-brand-deep">{es ? f.es : f.en}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ TRUST ══════════ -->
  <section id="confianza" class="bg-ink py-20 text-white lg:py-24">
    <div class="container-page grid items-center gap-14 lg:grid-cols-[1fr_0.9fr]">
      <div>
        <p class="mb-3 font-display text-[14px] font-bold tracking-[0.14em] text-brand uppercase">{t('trust.eyebrow')}</p>
        <h2 class="mb-6 font-display text-[clamp(1.9rem,4vw,3rem)] leading-[1.08] font-extrabold tracking-[-0.02em]">{t('trust.title')}</h2>
        <p class="mb-10 max-w-[52ch] text-[17px] leading-relaxed text-white/70">{t('trust.body')}</p>

        <div class="grid gap-x-8 gap-y-7 sm:grid-cols-2">
          {
            trustPoints.map((p) => (
              <div class="border-l-2 border-brand pl-5">
                <h3 class="mb-1.5 font-display text-[17px] font-bold">{p.title}</h3>
                <p class="text-[14.5px] leading-relaxed text-white/60">{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div>
        <img
          src={href('/images/office-cards.jpg')}
          alt={t('trust.imageAlt')}
          width="1406"
          height="544"
          loading="lazy"
          decoding="async"
          class="w-full rounded-2xl object-cover shadow-2xl"
        />
        <div class="mt-5 rounded-xl border border-white/10 bg-white/5 p-6">
          <h3 class="mb-3 text-[13px] font-semibold tracking-[0.1em] text-brand uppercase">{t('trust.teamLabel')}</h3>
          <p class="text-[15px] leading-relaxed text-white/80">{site.team.join(' · ')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ VISIT ══════════ -->
  <section id="visitanos" class="bg-white py-20 lg:py-24">
    <div class="container-page grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="mb-3 font-display text-[14px] font-bold tracking-[0.14em] text-brand-dark uppercase">{t('visit.eyebrow')}</p>
        <h2 class="mb-8 font-display text-[clamp(1.9rem,4vw,2.9rem)] leading-[1.1] font-extrabold tracking-[-0.02em]">{t('visit.title')}</h2>

        <div class="space-y-6">
          <p class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-brand"><Icon name="pin" size={22} /></span>
            <span>
              <span class="block font-display text-[17px] font-semibold">{street}, {unit}</span>
              <span class="block text-ink-soft">{city}, {region} {postalCode}</span>
            </span>
          </p>

          <p class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-brand"><Icon name="phone" size={22} solid /></span>
            <span>
              <a href={site.phoneHref} class="block py-1.5 font-display text-[17px] font-semibold transition hover:text-brand-dark">{site.phone}</a>
              <span class="block text-ink-soft">{t('visit.callOrWhatsapp')}</span>
            </span>
          </p>

          <div class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-brand"><Icon name="clock" size={22} /></span>
            <div class="w-full">
              <h3 class="mb-3 font-display text-[17px] font-semibold">{t('visit.hours')}</h3>
              <dl class="max-w-[300px] space-y-1.5 text-[15px]">
                {
                  site.hours.map((h) => (
                    <div class="flex justify-between gap-6">
                      <dt class="text-ink-soft">{es ? h.dayEs : h.dayEn}</dt>
                      <dd class={h.closed ? 'font-medium text-ink-mute' : 'font-medium'}>
                        {h.closed ? t('visit.closed') : `${h.opens} – ${h.closes}`}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>
          </div>
        </div>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row">
          <a
            href={site.phoneHref}
            class="inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3.5 font-display font-semibold text-white transition hover:bg-brand-dark"
          >
            {t('hero.callCta')}
          </a>
          <a
            href={site.mapsUrl}
            rel="noopener"
            class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-ink/15 px-6 py-3.5 font-display font-semibold transition hover:border-brand"
          >
            {t('visit.directions')}
          </a>
        </div>
      </div>

      <div class="flex min-h-[380px] items-center justify-center rounded-2xl border border-ink/10 bg-ink/5">
        <p class="px-6 text-center text-[14px] text-ink-mute">{t('visit.mapLabel')}</p>
      </div>
    </div>
  </section>
</main>
