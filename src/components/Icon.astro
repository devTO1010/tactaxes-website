  fileText: '<path d="M15.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6.5z"/><path d="M8 12h8M8 16h5"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.5"/><path d="M17.2 6.8h.01"/>',
} as const;

const { name, size = 24, class: className = '', solid = false } = Astro.props;

const strokeAttrs = solid
  ? { fill: 'currentColor', stroke: 'none' }
  : {
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width': '2',
      'stroke-linecap': 'round' as const,
      'stroke-linejoin': 'round' as const,
    };
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  class={className}
  aria-hidden="true"
  focusable="false"
  {...strokeAttrs}
  set:html={paths[name]}
/>
