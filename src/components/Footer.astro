---
import { site, type Locale } from '../data/site';
import { useTranslations } from '../i18n/ui';
import { featuredFamilies } from '../data/services';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { street, unit, city, region, postalCode } = site.address;

const socials = [
  { name: 'facebook', url: site.social.facebook, label: 'Facebook' },
  { name: 'instagram', url: site.social.instagram, label: 'Instagram' },
  { name: 'youtube', url: site.social.youtube, label: 'YouTube' },
  { name: 'tiktok', url: site.social.tiktok, label: 'TikTok' },
] as const;

const year = new Date().getFullYear();
---

<footer class="bg-ink pt-16 pb-28 text-white/60 lg:pb-16">
  <div class="container-page">
    <div class="grid gap-10 border-b border-white/10 pb-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="mb-4 flex items-center gap-2">
          <Logo size={30} onDark />
          <span class="font-display text-[19px] font-extrabold text-white">
            <span class="text-brand">TAC</span> Taxes
          </span>
        </div>
        <p class="mb-4 text-[13px] tracking-[0.18em] text-white/40 uppercase">{site.tagline}</p>
        <p class="max-w-[34ch] text-[15px] leading-relaxed">{t('footer.blurb')}</p>

        <div class="mt-6 flex gap-3">
          {
            socials.map((s) =>
              s.url ? (
                <a
                  href={s.url}
                  aria-label={s.label}
                  rel="noopener"
                  class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-brand"
                >
                  <Icon name={s.name} size={16} solid={s.name !== 'instagram'} />
                </a>
              ) : null
            )
          }
        </div>
      </div>

      <div>
        <h2 class="mb-4 font-display text-[15px] font-semibold text-white">{t('footer.services')}</h2>
        {/* py-2 keeps every tap target >=35px — this audience skews older and mobile. */}
        <ul class="space-y-0.5 text-[15px]">
          {
            featuredFamilies.slice(0, 5).map((f) => (
              <li>
                <a href="#servicios" class="inline-block py-2 transition hover:text-brand">
                  {lang === 'es' ? f.es : f.en}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-4 font-display text-[15px] font-semibold text-white">{t('footer.contact')}</h2>
        <ul class="space-y-0.5 text-[15px]">
          <li><a href={site.phoneHref} class="inline-block py-2 transition hover:text-brand">{site.phone}</a></li>
          <li class="py-2">{street}, {unit}<br />{city}, {region} {postalCode}</li>
          <li>
            <a href={site.whatsapp} rel="noopener" class="inline-block py-2 transition hover:text-brand">WhatsApp</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap justify-between gap-x-6 gap-y-2 pt-7 text-[13.5px] text-white/40">
      <p>© {year} {site.legalName}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>
